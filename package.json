{
  "name": "sim-rt-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "Sistem Informasi Manajemen RT (SIM-RT) Enterprise Monorepo - Zero-MDN, Defense-in-Depth, Clean Architecture",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter backend-api db:generate",
    "db:push": "pnpm --filter backend-api db:push",
    "db:migrate": "pnpm --filter backend-api db:migrate",
    "db:seed": "pnpm --filter backend-api db:seed",
    "postinstall": "pnpm --filter backend-api db:generate"
  },
  "overrides": {
    "fast-jwt": ">=6.3.0",
    "tar": ">=7.5.21",
    "sharp": ">=0.35.5",
    "deepmerge-ts": ">=8.0.0"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  }
}

