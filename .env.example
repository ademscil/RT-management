# ==============================================================================
# SIM-RT ENTERPRISE ENVIRONMENT CONFIGURATION (DEFENSE-IN-DEPTH SECURITY AUDITED)
# ==============================================================================

NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:5173
RESIDENT_MOBILE_URL=http://localhost:5174

# Database PostgreSQL 16 (RLS Enabled)
DATABASE_URL=postgresql://simrt_admin:simrt_super_secret_password_2026@localhost:5432/simrt_db?schema=public

# PII Cryptographic Vault (AES-256-GCM Envelope Encryption)
# KEK (Key Encryption Key) must be 32 bytes (256-bit) base64 or 64 hex characters
KEK_CURRENT_VERSION=v1
KEK_SECRET_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Blind Indexing Pepper (HMAC-SHA256 for NIK & No KK exact lookups)
BLIND_INDEX_PEPPER=simrt_super_secure_blind_index_pepper_salt_998877665544332211

# JWT Authentication
JWT_ACCESS_SECRET=simrt_jwt_access_secret_super_secure_key_2026_xyz
JWT_REFRESH_SECRET=simrt_jwt_refresh_secret_super_secure_key_2026_abc
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO Private Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=simrt_minio_admin
MINIO_SECRET_KEY=simrt_minio_super_secret_2026
MINIO_BUCKET_DOCUMENTS=dokumen-warga
MINIO_BUCKET_RECEIPTS=kas-nota
MINIO_BUCKET_LETTERS=surat-arsip

# RT Information Default
DEFAULT_NO_RT=05
DEFAULT_NO_RW=02
DEFAULT_KELURAHAN=Sukamaju
DEFAULT_KECAMATAN=Cilodong
DEFAULT_KOTA=Kota Depok
DEFAULT_KODEPOS=16415

# ==============================================================================
# SAAS BILLING — MIDTRANS (RT SUBSCRIPTION PAYMENTS)
# ==============================================================================
# Get keys from: https://dashboard.midtrans.com → Settings → Access Keys
# NEVER commit real keys. The API refuses to start a charge without these.

# Server key — SECRET. Used to authorise Core/Snap API calls server-side only.
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx

# Client key — PUBLIC. Safe to expose to the admin panel browser.
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx

# "true" for live merchant, "false" for sandbox. Drives the API base URL.
MIDTRANS_IS_PRODUCTION=false

# Midtrans merchant id (shown on the Access Keys page).
MIDTRANS_MERCHANT_ID=Mxxxxxxxxxx

# SHA-512 notification signature is verified with the server key, so no extra
# secret is required. The endpoint is POST /api/v1/billing/webhook/midtrans
# Configure that URL under Settings → Payment → Notification URL.

# Optional: unauthenticated billing endpoints are additionally gated behind this
# shared secret when set (useful for self-hosted deployments behind a proxy).
MIDTRANS_WEBHOOK_ALLOWED_IPS=

# ==============================================================================
# SELF-HOSTED MODE
# ==============================================================================
# "true" enables MANUAL_TRANSFER invoices, letting a SUPERUSER verify a bank
# transfer by hand instead of calling Midtrans. Intended for buyers who run
# SIM-RT entirely on-premise with no payment gateway.
BILLING_MANUAL_TRANSFER_ENABLED=false

